        "password_chars": 12,
        "response": {
          "status": 302,
          "headers": [
            [
              "location",
              "https://oneapp.example.test/redirect?state=ccsp&code=C%2B1"
            ]
          ],
          "url": "",
          "body": ""
        },
        "expect": {
          "ok": "C+1"
        }
      },
      {
