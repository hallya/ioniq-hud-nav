  "signin": {
    "inputs": {
      "username": "user+test@example.test",
      "encrypted_password_hex": "abababababababab",
      "kid": "test-kid"
    },
    "request": {
      "method": "POST",
      "url": "https://idp.example.test/auth/account/signin",
      "headers": [
        [
          "User-Agent",
          "Mozilla/5.0 (Linux; Android 10; K) ExampleBrowser/1.0_CCS_APP_AOS"
        ],
        [
          "Content-Type",
          "application/x-www-form-urlencoded"
        ]
      ],
      "body": "client_id=00000000-0000-4000-8000-0000000000a1&encryptedPassword=true&password=abababababababab&redirect_uri=https%3A%2F%2Foneapp.example.test%2Fredirect&scope=&nonce=&state=ccsp&username=user%2Btest%40example.test&connector_session_key=&kid=test-kid&_csrf=",
      "follow_redirects": false
    },
    "responses": [
      {
        "name": "code",
        "password_chars": 12,
        "response": {
          "status": 302,
          "headers": [
            [
              "Location",
              "https://oneapp.example.test/redirect?code=CODE-123_abc.~&state=ccsp"
            ]
          ],
          "url": "",
          "body": ""
        },
        "expect": {
          "ok": "CODE-123_abc.~"
        }
      },
      {
